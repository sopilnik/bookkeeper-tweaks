{
  "name": "bookkeeper-tweaks",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension with small fixes to Xero's web pages for bookkeepers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sopilnik/bookkeeper-tweaks.git"
  },
  "author": "Alexandr Sopilnik",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "lint": "eslint --max-warnings 0 scripts src tests *.js *.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "zip": "node scripts/zip.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
