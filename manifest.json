{
  "manifest_version": 3,
  "name": "Bookkeeper Tweaks",
  "version": "0.1.0",
  "description": "Small fixes to Xero's own web pages for bookkeepers. Not affiliated with or endorsed by Xero Limited.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://go.xero.com/app/*"],
      "js": ["app.js"],
      "css": ["app.css"],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
